# Copiado para .env pelo `make up`, que troca as senhas por valores aleatórios.
# Nunca commite o .env.
POSTGRES_PASSWORD=troque-me
GESTOR_SENHA=troque-me
# conta de gestor criada na subida (entra com este e-mail + GESTOR_SENHA)
GESTOR_EMAIL=gestor@antecipe.local
# Chave interna entre o nginx e o assistente de IA (o make up gera uma aleatória)
AI_SECURITY_KEY=troque-me
LOG_LEVEL=info
# Assistente de IA (OpenRouter). Sem a chave, o resto do Antecipe funciona e o assistente fica indisponível.
OPENROUTER_API_KEY=
# Opcional: outro modelo do OpenRouter (padrão deepseek/deepseek-v4-flash).
AI_MODELO=
