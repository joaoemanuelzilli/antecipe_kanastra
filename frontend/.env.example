# npm run demo usa mocks do contrato. npm run dev aponta para o Go.
VITE_MOCK_API=false
API_PROXY_TARGET=http://localhost:8080
# Opcional para frontend e API em domínios diferentes. Exige CORS no Go.
VITE_API_BASE_URL=

# Nginx local do grupo, sem chave no navegador
AI_PROXY_TARGET=http://localhost:3000

# Base pública da IA, incluindo /ai se estiver atrás do nginx do grupo.
# Vazio: /ai na mesma origem. Nunca colocar tokens nesta variável.
# Exemplo: VITE_AI_BASE_URL=https://api.exemplo.com/ai
VITE_AI_BASE_URL=
