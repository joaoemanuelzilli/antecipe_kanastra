# Endereços dos serviços vêm do ambiente: no compose, api:8080 e ai:7777 (padrão do Dockerfile);
# na Railway, <serviço>.railway.internal. O DNS é resolvido a cada 10 s, porque o IP interno muda a cada deploy.
resolver ${NGINX_LOCAL_RESOLVERS} valid=10s;

server {
    listen 80;
    listen [::]:80;
    server_name _;
    root /usr/share/nginx/html;

    # Lotes de até 500 mil linhas (~100 MB)
    client_max_body_size 300m;

    location /api/ {
        set $api http://${API_UPSTREAM};
        proxy_pass $api;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Request-Id $request_id;
        # repassa o https da borda (Railway) para a API marcar o cookie de sessão como Secure
        proxy_set_header X-Forwarded-Proto $http_x_forwarded_proto;
        proxy_request_buffering off;
        proxy_buffering off;
        proxy_read_timeout 300s;
        proxy_send_timeout 300s;
    }

    # Assistente de IA: /ai/agents/antecipe-assistente/runs → AgentOS. Sem buffer para o streaming (SSE).
    # Assistente de IA. O AgentOS exige a chave (OS_SECURITY_KEY); só o nginx a conhece e a injeta,
    # e só nas duas rotas que o front usa. O resto do AgentOS (/sessions, /config, /docs…) não sai daqui.
    location = /ai/assistente/status {
        set $ai ${AI_UPSTREAM};
        proxy_pass http://$ai/assistente/status;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Request-Id $request_id;
        proxy_set_header Authorization "Bearer ${AI_SECURITY_KEY}";
    }

    # POST da pergunta; sem buffer para o streaming (SSE)
    location = /ai/agents/antecipe-assistente/runs {
        limit_except POST { deny all; }
        set $ai ${AI_UPSTREAM};
        proxy_pass http://$ai/agents/antecipe-assistente/runs;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Request-Id $request_id;
        proxy_set_header Authorization "Bearer ${AI_SECURITY_KEY}";
        proxy_buffering off;
        proxy_cache off;
        proxy_read_timeout 300s;
    }

    location /ai/ {
        return 404;
    }

    location / {
        try_files $uri /index.html;
    }
}
